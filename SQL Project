select c.customer_name,a.account_type,t.transaction_type  from customerr c
inner join accountss a on c.customer_id = a.customer_id
inner join transactionss t on a.account_id = t.account_id

1. Display customer name and account balance

select c.customer_name,a.balance from customerr c
inner join accountss a on c.customer_id = a.customer_id

2. Find customers with failed transactions

select c.customer_name,t.status from customerr c
inner join accountss a on c.customer_id = a. customer_id 
inner join transactionss t on a.account_id = t.account_id
where status = 'failed'

3. Find customers who have made transactions above ₹1,00,000. Display customer name, account ID,
 transaction ID and amount.
 
select c.customer_name,a.account_id,t.transaction_id,t.amount from customerr c
inner join accountss a on c.customer_id = a. customer_id 
inner join transactionss t on a.account_id = t.account_id
where amount > 100000

4. Find customers who have made more than 5 successful transactions. 
Display customer name and total transaction count.

select c.customer_name,count(t.transaction_id) 
as total_transactions from customerr c
inner join accountss a on c.customer_id = a. customer_id 
inner join transactionss t on a.account_id = t.account_id
where t.status = 'success' 
group by
c.customer_id,
c.customer_name
having count(t.transaction_id)  >= 5 

5.Find customers whose total failed transaction amount exceeds ₹30,000.

select c.customer_name,sum(t.amount)
as total_transactions from customerr c
inner join accountss a on c.customer_id = a. customer_id 
inner join transactionss t on a.account_id = t.account_id
where t.status ="failed"
group by 
c.customer_id,
c.customer_name
having sum(t.amount) > 30000

6.Find accounts where total successful withdrawal amount is greater than ₹1,00,000.

select c.customer_name,a.account_id,sum(t.amount)
as total_amount from customerr c
inner join accountss a on c.customer_id = a. customer_id 
inner join transactionss t on a.account_id = t.account_id
where t.status ="success" and t.transaction_type ='withdrawal'
group by c.customer_name,
a.account_id
having sum(t.amount) > 100000

7.Display customer name, account type, total transaction amount and transaction count.
 Include only customers whose total transaction amount is above ₹2,00,000.
 
 select c.customer_name,a.account_type,sum(t.amount) as total_amount,
 count(transaction_id) as total_transaction from customerr c
inner join accountss a on c.customer_id = a. customer_id 
inner join transactionss t on a.account_id = t.account_id
group by c.customer_name,a.account_id 
having sum(t.amount) > 200000

8.Find customers who do not have any accounts using MySQL JOIN.

select c.customer_name from customerr c
left join accountss a on c.customer_id = a. customer_id 
where a.account_id = 'null'

9.Find accounts that have never made any transactions.

select a.account_id,a.customer_id from accountss a
left join transactionss t on a.account_id = t.account_id
where t.transaction_id = 'null'

10.Find customers who have accounts but no successful transactions.

select c.customer_name,a.account_id,t.status from customerr c
inner join accountss a on c.customer_id = a.customer_id
left join transactionss t on a.account_id = t.account_id and t.status = 'success'
where t.transaction_id = 'null'

11. Find all accounts and their transaction counts, including accounts with zero transactions.

select a.account_id,a.customer_id,count(t.transaction_id)  from accountss a
left join transactionss t on a.account_id = t.account_id
group by a.account_id,a.customer_id

12.Find customers who have never made a failed transaction.

select c.customer_id,c.customer_name,a.account_id from customerr c
inner join accountss a on c.customer_id = a.customer_id
left join transactionss t on a.account_id = t.account_id and t.status = 'FAILED'
where t.transaction_id is null

13.Find transactions where the same account made two transactions.

select a.account_id,a.customer_id,count(t.transaction_id) as total_transactions from accountss a
left join transactionss t on a.account_id = t.account_id
group by a.account_id having count(t.transaction_id) > 2

14.Find transactions where the same account transferred the same amount
 to the same receiver more than once.
 
 select a.account_id,t.receiver_account,t.amount from accountss a
inner join transactionss t on a.account_id = t.account_id
 where t.transaction_type ='transfer' and t.status = 'success'
 group by a.account_id,t.receiver_account,t.amount
 having count(*) > 1
 
 
 
